<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yaplin"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#5E17EB"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avisos de cobro por voz (Yape y Plin)"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Panel de Estado del Servicio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:gravity="center"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Servicio ACTIVO"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="#E8F5E9"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escuchando notificaciones en segundo plano"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnPermissions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Permisos de Notificación"
                android:layout_marginTop="16dp"
                android:backgroundTint="#5E17EB"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Panel de Calibración de Audio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calibración de Audio"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prueba el volumen antes de iniciar tu jornada."
                android:textColor="#777777"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnTestAudio"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="▶ Probar sonido (Yape S/ 10)"
                android:backgroundTint="#EDE7F6"
                android:textColor="#5E17EB"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botón para Ajustes de Batería -->
        <Button
            android:id="@+id/btnBatterySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙ Configurar batería sin restricciones"
            android:backgroundTint="#ECEFF1"
            android:textColor="#455A64"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Pie de página -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creado por: rasec-alay • Versión 1.1"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
